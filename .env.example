# Set this only after the FoodGuard contract has been deployed and verified on
# GenLayer StudioNet (chain ID 61999). Leave it blank before deployment.
NEXT_PUBLIC_FOODGUARD_ADDRESS=

# Stable public origin used for canonical evidence source URLs. Do not include a
# path; the create-order commitment always binds /create.
NEXT_PUBLIC_FOODGUARD_APP_ORIGIN=https://foodguard.example
