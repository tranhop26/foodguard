# Set this only after the FoodGuard contract has been deployed and verified on
# GenLayer StudioNet (chain ID 61999). Leave it blank before deployment.
NEXT_PUBLIC_FOODGUARD_ADDRESS=

# Optional public *review metadata* for the read-only proof page. Set every
# value only from a separately reviewed deploy/studionet-manifest.json after
# finality, execution success, source-hash matching, and authoritative
# readback are confirmed. Blank or malformed values deliberately display an
# unavailable deployment record. These values are never a live StudioNet
# proof on their own: the browser must still check the StudioNet RPC deploy
# transaction, deployed code/hash, and exact get_order readback before it may
# label a record VERIFIED. Lifecycle values must be exactly FINALIZED,
# EXECUTION_SUCCESS, READBACK_CONFIRMED, and true respectively. Both hashes
# must be nonzero, 0x-prefixed 64-hex-character values.
NEXT_PUBLIC_FOODGUARD_DEPLOYMENT_ADDRESS=
NEXT_PUBLIC_FOODGUARD_DEPLOYMENT_CHAIN_ID=
NEXT_PUBLIC_FOODGUARD_SOURCE_SHA256=
NEXT_PUBLIC_FOODGUARD_DEPLOYMENT_TRANSACTION_HASH=
NEXT_PUBLIC_FOODGUARD_DEPLOYMENT_FINALITY=
NEXT_PUBLIC_FOODGUARD_DEPLOYMENT_EXECUTION=
NEXT_PUBLIC_FOODGUARD_DEPLOYMENT_READBACK=
NEXT_PUBLIC_FOODGUARD_SOURCE_HASH_MATCH=

# Required before payable order creation can be enabled. Set this to the real
# deployed HTTPS origin only (for example, https://foodguard.your-domain.tld).
# Do not include credentials, a path, query, or fragment; /create is appended.
NEXT_PUBLIC_FOODGUARD_APP_ORIGIN=
