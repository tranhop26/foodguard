# Set this only after the FoodGuard contract has been deployed and verified on
# GenLayer StudioNet (chain ID 61999). Leave it blank before deployment.
NEXT_PUBLIC_FOODGUARD_ADDRESS=

# Required before payable order creation can be enabled. Set this to the real
# deployed HTTPS origin only (for example, https://foodguard.your-domain.tld).
# Do not include credentials, a path, query, or fragment; /create is appended.
NEXT_PUBLIC_FOODGUARD_APP_ORIGIN=
